# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Only DATABASE_URL is needed for import/replay. API keys are never set here;
# see "API keys" below. Everything under "Optional" has a default.

# --- Required -----------------------------------------------------------------

# Postgres the CLI imports into / replays against (local Supabase shown).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Workspace root holding intake state (ledgers, resolved-property cache, logs).
INTAKE_WORKSPACE=./intake-workspace/dev

# --- API keys ------------------------------------------------------------------

# The acquire, requests and `sources daily` commands read these from AWS Systems Manager
# Parameter Store (/policeconduct/secrets/<NAME>) the first time each is needed.
# A value set here is ignored. Reading them needs AWS credentials:
# AWS_PROFILE=section1983-setup-admin
#
#   ANTHROPIC_API_KEY           CourtListener complaint summaries, Minnesota
#                               POST disciplinary orders, `requests sync`
#   CLEARING_HOUSE_API_TOKEN    acquire net/clearinghouse/api
#   COURTLISTENER_API_TOKEN     acquire com/courtlistener/www/api, and its
#                               complaint summaries in `data generate`
#   NEWS_INFERENCE_API_KEY      `sources daily com/serpapi/landing-page-search`
#   RESEND_API_KEY              `requests submit` by email
#   RESEND_API_KEY_FULL_ACCESS  `requests sync`
#   SEARCH_CONSOLE_CREDENTIALS  `sources daily com/serpapi/landing-page-search` (JSON)
#   SERPAPI_KEY                 `sources daily com/serpapi/landing-page-search`
#   YOUTUBE_API_KEY             acquire com/youtube/policeactivity (YouTube Data API v3)

# --- Records requests (same Resend provider as the Forms API) ------------------
# Receiving must be enabled; see docs/records-requests.md.
RECORDS_REQUEST_FROM=
RECORDS_REQUEST_RECEIVING_ADDRESS=
RECORDS_REQUEST_REQUESTER=
ANTHROPIC_MODEL=
# Portal contact JSON: firstName,lastName,email,phone,organization,street,city,state,zip.
# email must equal RECORDS_REQUEST_RECEIVING_ADDRESS.
RECORDS_REQUEST_CONTACT=

# --- Optional (defaults in code) ----------------------------------------------

# CourtListener: earliest docket year to fetch. Default in code.
# COURTLISTENER_MIN_YEAR=2010

# com/youtube/policeactivity: earliest year to backfill (one agency-year per run, newest first).
# Defaults to the current year; prod widens it (e.g. current year minus 5).
# YOUTUBE_MIN_YEAR=2021

# Override the source page URLs (default to the real public pages).
# CENSUS_GAZETTEER_PAGE_URL=
# FEDERAL_LE_PAGE_URL=

# Minnesota POST scrapes via a headless browser (Claude-in-Chrome / Puppeteer).
# CHROME_EXECUTABLE_PATH=            # use a specific Chrome instead of the bundled one
# MN_POST_HEADLESS=true             # "true" runs headless; anything else is headed
# MN_POST_CAPTCHA_WAIT_MS=          # ms to pause for a manual CAPTCHA solve

# Root for shared generated IO (specs/fixtures). Defaults to the repo copy.
# INTAKE_SHARED_IO_ROOT=

# pino log level. Default "info".
# LOG_LEVEL=info
