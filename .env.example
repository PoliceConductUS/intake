# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Only DATABASE_URL is needed for import/replay; the API tokens are needed only
# to `acquire` the source they name. Everything under "Optional" has a default.

# --- Required -----------------------------------------------------------------

# Postgres the CLI imports into / replays against (local Supabase shown).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Workspace root holding intake state (ledgers, resolved-property cache, logs).
INTAKE_WORKSPACE=./intake-workspace/dev

# --- Acquire tokens (only for the source that uses them) ----------------------

# `acquire clearinghouse-api` fails loud without this.
CLEARING_HOUSE_API_TOKEN=

# `acquire courtlistener` fails loud without this.
COURT_LISTENER_API_TOKEN=

# `acquire youtube.*` (the video-coverage sources) fails loud without this.
# A YouTube Data API v3 key (Google Cloud console).
YOUTUBE_API_KEY=

# --- Optional (defaults in code) ----------------------------------------------

# courtlistener: earliest docket year to fetch. Default in code.
# COURTLISTENER_MIN_YEAR=2010

# Override the source page URLs (default to the real public pages).
# CENSUS_GAZETTEER_PAGE_URL=
# FEDERAL_LE_PAGE_URL=

# mn-post scrapes via a headless browser (Claude-in-Chrome / Puppeteer).
# CHROME_EXECUTABLE_PATH=            # use a specific Chrome instead of the bundled one
# MN_POST_HEADLESS=true             # "true" runs headless; anything else is headed
# MN_POST_CAPTCHA_WAIT_MS=          # ms to pause for a manual CAPTCHA solve

# Root for shared generated IO (specs/fixtures). Defaults to the repo copy.
# INTAKE_SHARED_IO_ROOT=

# pino log level. Default "info".
# LOG_LEVEL=info

# Test-only: overrides INTAKE_WORKSPACE when set (isolates test state).
# INTAKE_WORKSPACE_TEST=./intake-workspace/test
