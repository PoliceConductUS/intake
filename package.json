{
  "name": "intake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/cli/index.ts",
  "bin": {
    "intake": "src/cli/index.ts"
  },
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate:envelope-types": "tsx scripts/generate-envelope-types.ts",
    "generate:data-request-doc": "tsx scripts/generate-data-request-doc.ts",
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "setup": "bash scripts/bootstrap-dev.sh",
    "doctor": "bash scripts/bootstrap-dev.sh --check",
    "cli": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=12288\" tsx src/cli/index.ts",
    "format": "prettier --write \"**/*.{json,md,ts,yml,yaml}\"",
    "format:sql": "mise exec -- uvx sqlfluff==4.5.0 format --dialect postgres --processes 1 --disable-progress-bar .",
    "format:check": "prettier --check \"**/*.{json,md,ts,yml,yaml}\"",
    "lint": "bash -n scripts/bootstrap-dev.sh && npm run typecheck",
    "lint:sql": "mise exec -- uvx sqlfluff==4.5.0 lint --dialect postgres --processes 1 --disable-progress-bar .",
    "openspec:status": "openspec status",
    "openspec:validate": "openspec validate --all",
    "publish:import-schemas": "tsx scripts/publish-import-schemas.ts",
    "supabase:start": "SUPABASE_TELEMETRY_DISABLED=1 supabase start",
    "supabase:stop": "SUPABASE_TELEMETRY_DISABLED=1 supabase stop",
    "supabase:reset": "SUPABASE_TELEMETRY_DISABLED=1 supabase db reset",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run format:check && npm run lint && npm run test:vitest && npm run build && npm run openspec:validate"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^2.0.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.20.4",
    "@types/shapefile": "^0.6.4",
    "@types/yauzl": "^3.4.0",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "tsx": "^4.22.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "commander": "^15.1.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "namecase": "^1.1.2",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "polygon-clipping": "^0.15.7",
    "shapefile": "^0.6.6",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "playwright": "^1.65.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1",
      "unzipper": "^0.12.5",
      "fast-csv": "^5.0.8"
    },
    "archiver-utils": {
      "glob": "^14.0.6"
    },
    "shapefile": {
      "text-encoding": "npm:@kayahr/text-encoding@2.2.0"
    }
  },
  "allowScripts": {
    "@fission-ai/openspec@1.3.1": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "ssh2@1.17.0": true,
    "protobufjs@7.6.6": true
  }
}
