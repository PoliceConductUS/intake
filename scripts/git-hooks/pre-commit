#!/usr/bin/env bash
set -euo pipefail

worktrees=$(git worktree list --porcelain | grep -c '^worktree ')
if ((worktrees > 2)) && [[ "${INTAKE_ALLOW_EXTRA_WORKTREES:-}" != "1" ]]; then
  echo "pre-commit: $((worktrees - 1)) worktrees exist besides the main checkout; AGENTS.md allows one. Run 'git worktree list' and remove the extras. The user, never an agent, may override with INTAKE_ALLOW_EXTRA_WORKTREES=1." >&2
  exit 1
fi

npm run validate
